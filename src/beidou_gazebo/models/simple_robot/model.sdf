<?xml version="1.0"?>

<sdf version="1.9">

  <model name="simple_robot">

    <static>false</static>

    <!-- 机器人整体位置 -->
    <pose>0 0 0.25 0 0 0</pose>


    <!-- ================================================= -->
    <!--                    机器人底盘                     -->
    <!-- ================================================= -->

    <link name="base_link">

      <inertial>
        <pose>-0.02 0 0 0 0 0</pose>
        <mass>5.0</mass>

        <inertia>
          <ixx>0.5</ixx>
          <iyy>0.5</iyy>
          <izz>0.5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>


      <collision name="collision">

        <geometry>
          <box>
            <size>1.0 0.7 0.3</size>
          </box>
        </geometry>

      </collision>


      <visual name="visual">

        <geometry>
          <box>
            <size>1.0 0.7 0.3</size>
          </box>
        </geometry>

        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>

      </visual>

    </link>


    <!-- 2D lidar mounted above the chassis -->
    <link name="lidar_link">
      <pose>0 0 0.65 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>0.06</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.08</radius><length>0.06</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>true</visualize><gz_frame_id>lidar_link</gz_frame_id>
        <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal></scan><range><min>0.10</min><max>10.0</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>


    <!-- ================================================= -->
    <!--                      左轮                         -->
    <!-- ================================================= -->
<link name="left_wheel">

  <pose>0 0.42 0 0 0 0</pose>

  <inertial>
    <mass>0.5</mass>
    <inertia>
      <ixx>0.02</ixx>
      <iyy>0.02</iyy>
      <izz>0.02</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
    </inertia>
  </inertial>

  <collision name="collision">
    <pose>0 0 0 1.570796 0 0</pose>

    <geometry>
      <cylinder>
        <radius>0.22</radius>
        <length>0.002</length>
      </cylinder>
    </geometry>
    <surface>
      <friction>
        <ode>
          <mu>0.8</mu>
          <mu2>0.8</mu2>
        </ode>
      </friction>
    </surface>
  </collision>

  <visual name="visual">
    <pose>0 0 0 1.570796 0 0</pose>

    <geometry>
      <cylinder>
        <radius>0.22</radius>
        <length>0.12</length>
      </cylinder>
    </geometry>

    <material>
      <ambient>0.05 0.05 0.05 1</ambient>
      <diffuse>0.05 0.05 0.05 1</diffuse>
    </material>
  </visual>

</link>


    <!-- ================================================= -->
    <!--                      右轮                         -->
    <!-- ================================================= -->

<link name="right_wheel">

  <pose>0 -0.42 0 0 0 0</pose>

  <inertial>
    <mass>0.5</mass>
    <inertia>
      <ixx>0.02</ixx>
      <iyy>0.02</iyy>
      <izz>0.02</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
    </inertia>
  </inertial>

  <collision name="collision">
    <pose>0 0 0 1.570796 0 0</pose>

    <geometry>
      <cylinder>
        <radius>0.22</radius>
        <length>0.002</length>
      </cylinder>
    </geometry>
    <surface>
      <friction>
        <ode>
          <mu>0.8</mu>
          <mu2>0.8</mu2>
        </ode>
      </friction>
    </surface>
  </collision>

  <visual name="visual">
    <pose>0 0 0 1.570796 0 0</pose>

    <geometry>
      <cylinder>
        <radius>0.22</radius>
        <length>0.12</length>
      </cylinder>
    </geometry>

    <material>
      <ambient>0.05 0.05 0.05 1</ambient>
      <diffuse>0.05 0.05 0.05 1</diffuse>
    </material>
  </visual>

</link>


    <!-- ================================================= -->
    <!--                 后部被动球形支撑                  -->
    <!-- ================================================= -->

    <link name="rear_caster">

      <pose>-0.40 0 -0.14 0 0 0</pose>

      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.000205</ixx>
          <iyy>0.000205</iyy>
          <izz>0.000205</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>
              <mu2>0.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

    </link>

    <joint name="rear_caster_joint" type="ball">
      <parent>base_link</parent>
      <child>rear_caster</child>
    </joint>


    <!-- ================================================= -->
    <!--                    左轮关节                       -->
    <!-- ================================================= -->

    <joint name="left_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>left_wheel</child>

      <axis>

        <!-- 轮子绕 Y 轴旋转 -->
        <xyz>0 1 0</xyz>

        <dynamics>
          <damping>0.1</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>


    <!-- ================================================= -->
    <!--                    右轮关节                       -->
    <!-- ================================================= -->

    <joint name="right_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>right_wheel</child>

      <axis>

        <!-- 轮子绕 Y 轴旋转 -->
        <xyz>0 1 0</xyz>

        <dynamics>
          <damping>0.1</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>


    <!-- ================================================= -->
    <!--                     前方标记                      -->
    <!-- ================================================= -->

    <link name="front_marker">

      <pose>0.52 0 0.42 0 0 0</pose>

      <visual name="visual">

        <geometry>

          <box>
            <size>0.08 0.5 0.08</size>
          </box>

        </geometry>

        <material>

          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>1.0 0.1 0.1 1</diffuse>

        </material>

      </visual>

    </link>


    <!-- ================================================= -->
    <!--                  Gazebo 差速驱动                  -->
    <!-- ================================================= -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>

      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.84</wheel_separation>

      <wheel_radius>0.22</wheel_radius>

      <max_linear_velocity>1.0</max_linear_velocity>

      <max_angular_velocity>2.0</max_angular_velocity>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>

      <tf_topic>/tf</tf_topic>

      <frame_id>odom</frame_id>

      <child_frame_id>base_link</child_frame_id>

    </plugin>


  </model>

</sdf>
