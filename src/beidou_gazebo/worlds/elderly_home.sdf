<?xml version="1.0"?>

<sdf version="1.9">

  <world name="elderly_home">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== 场景环境 ==================== -->

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>


    <!-- ==================== 光源 ==================== -->

    <light name="sun" type="directional">

      <pose>0 0 10 0 0 0</pose>

      <cast_shadows>true</cast_shadows>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>

      <direction>-0.5 0.5 -1</direction>

    </light>


    <!-- ==================== 地面 ==================== -->

    <model name="ground">

      <static>true</static>

      <link name="link">

        <!-- 地面碰撞 -->
        <collision name="collision">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>

          </geometry>

        </collision>


        <!-- 地面显示 -->

        <visual name="visual">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>

          </geometry>

          <material>

            <ambient>0.7 0.7 0.7 1</ambient>

            <diffuse>0.8 0.8 0.8 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 左侧墙 ==================== -->

    <model name="wall_left">

      <static>true</static>

      <pose>-10 0 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>0.3 20 2</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>0.3 20 2</size>
            </box>

          </geometry>

          <material>

            <ambient>0.8 0.8 0.8 1</ambient>

            <diffuse>0.9 0.9 0.9 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 右侧墙 ==================== -->

    <model name="wall_right">

      <static>true</static>

      <pose>10 0 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>0.3 20 2</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>0.3 20 2</size>
            </box>

          </geometry>

          <material>

            <ambient>0.8 0.8 0.8 1</ambient>

            <diffuse>0.9 0.9 0.9 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 上侧墙 ==================== -->

    <model name="wall_back">

      <static>true</static>

      <pose>0 10 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>20 0.3 2</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>20 0.3 2</size>
            </box>

          </geometry>

          <material>

            <ambient>0.8 0.8 0.8 1</ambient>

            <diffuse>0.9 0.9 0.9 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 下侧墙 ==================== -->

    <model name="wall_front">

      <static>true</static>

      <pose>0 -10 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>20 0.3 2</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>20 0.3 2</size>
            </box>

          </geometry>

          <material>

            <ambient>0.8 0.8 0.8 1</ambient>

            <diffuse>0.9 0.9 0.9 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 障碍物1：桌子 ==================== -->

    <model name="obstacle_table">

      <static>true</static>

      <pose>-3 3 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>2 2 1</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>2 2 1</size>
            </box>

          </geometry>

          <material>

            <ambient>0.5 0.25 0.1 1</ambient>

            <diffuse>0.6 0.3 0.1 1</diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 障碍物2：柜子 ==================== -->

    <model name="obstacle_cabinet">

      <static>true</static>

      <pose>-2 -3 0.75 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>1.5 3 1.5</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>1.5 3 1.5</size>
            </box>

          </geometry>

          <material>

            <ambient>0.2 0.4 0.7 1</ambient>

            <diffuse>0.3 0.5 0.8 1</diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 障碍物3：隔断 ==================== -->

    <model name="obstacle_partition">

      <static>true</static>

      <pose>3 -1 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>1 4 2</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>1 4 2</size>
            </box>

          </geometry>

          <material>

            <ambient>0.2 0.6 0.3 1</ambient>

            <diffuse>0.3 0.7 0.4 1</diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 老人模型 ==================== -->

    <model name="elder">

      <!-- 老人整体位置 -->
      <pose>6 5 0 0 0 0</pose>

      <static>false</static>


      <!-- 老人身体 -->

      <link name="body_link">

        <pose>0 0 0.75 0 0 0</pose>

        <gravity>false</gravity>

        <inertial>
          <mass>60.0</mass>
          <inertia>
            <ixx>12.6</ixx>
            <iyy>12.6</iyy>
            <izz>2.7</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="body_collision">

          <geometry>

            <cylinder>
              <radius>0.3</radius>
              <length>1.5</length>
            </cylinder>

          </geometry>

        </collision>


        <visual name="body_visual">

          <geometry>

            <cylinder>
              <radius>0.3</radius>
              <length>1.5</length>
            </cylinder>

          </geometry>

          <material>

            <ambient>0.2 0.3 0.8 1</ambient>

            <diffuse>0.3 0.4 0.9 1</diffuse>

          </material>

        </visual>

      </link>


      <!-- 老人头部 -->

      <link name="head_link">

        <pose>0 0 1.7 0 0 0</pose>

        <gravity>false</gravity>

        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.125</ixx>
            <iyy>0.125</iyy>
            <izz>0.125</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="head_collision">

          <geometry>

            <sphere>
              <radius>0.25</radius>
            </sphere>

          </geometry>

        </collision>


        <visual name="head_visual">

          <geometry>

            <sphere>
              <radius>0.25</radius>
            </sphere>

          </geometry>

          <material>

            <ambient>0.9 0.7 0.5 1</ambient>

            <diffuse>1 0.8 0.6 1</diffuse>

          </material>

        </visual>

      </link>

      <joint name="head_fixed_joint" type="fixed">
        <parent>body_link</parent>
        <child>head_link</child>
      </joint>

      <plugin
        filename="gz-sim-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
        <topic>/model/elder/cmd_vel</topic>
      </plugin>

    </model>
<!-- ==================== 移动机器人 ==================== -->

<include>

  <uri>model://simple_robot</uri>

  <name>elderly_robot</name>

  <!-- Start 1.46 m to the left/rear of the elder initial heading toward (3, 3). -->
  <pose>7.4 5.45 0.3 0 0 -2.554</pose>

</include>

  </world>

</sdf>
