<?xml version="1.0"?>

<sdf version="1.9">

  <world name="elderly_final">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== 场景环境 ==================== -->

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>


    <!-- ==================== 光源 ==================== -->

    <light name="sun" type="directional">

      <pose>0 0 10 0 0 0</pose>

      <cast_shadows>true</cast_shadows>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>

      <direction>-0.5 0.5 -1</direction>

    </light>


    <!-- ==================== 地面 ==================== -->

    <model name="ground">

      <static>true</static>

      <link name="link">

        <!-- 地面碰撞 -->
        <collision name="collision">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>

          </geometry>

        </collision>


        <!-- 地面显示 -->

        <visual name="visual">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>

          </geometry>

          <material>

            <ambient>0.7 0.7 0.7 1</ambient>

            <diffuse>0.8 0.8 0.8 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 左侧墙 ==================== -->

    <model name="wall_left">

      <static>true</static>

      <pose>-10 0 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>0.3 16 2</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>0.3 16 2</size>
            </box>

          </geometry>

          <material>

            <ambient>0.8 0.8 0.8 1</ambient>

            <diffuse>0.9 0.9 0.9 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 右侧墙 ==================== -->

    <model name="wall_right">

      <static>true</static>

      <pose>10 0 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>0.3 16 2</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>0.3 16 2</size>
            </box>

          </geometry>

          <material>

            <ambient>0.8 0.8 0.8 1</ambient>

            <diffuse>0.9 0.9 0.9 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 上侧墙 ==================== -->

    <model name="wall_back">

      <static>true</static>

      <pose>0 8 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>20 0.3 2</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>20 0.3 2</size>
            </box>

          </geometry>

          <material>

            <ambient>0.8 0.8 0.8 1</ambient>

            <diffuse>0.9 0.9 0.9 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 下侧墙 ==================== -->

    <model name="wall_front">

      <static>true</static>

      <pose>0 -8 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>20 0.3 2</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>20 0.3 2</size>
            </box>

          </geometry>

          <material>

            <ambient>0.8 0.8 0.8 1</ambient>

            <diffuse>0.9 0.9 0.9 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ==================== 养老院户外障碍物 ==================== -->

    <!-- Flower bed: outside the main walking lane, with clearance around it. -->
    <model name="final_flowerbed">
      <static>true</static><pose>-2.5 2.0 0.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>2.5 1.5 0.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>2.5 1.5 0.5</size></box></geometry><material><ambient>0.15 0.5 0.15 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material></visual></link>
    </model>

    <!-- Two simple benches along the lower edge of the safe activity area. -->
    <model name="final_bench_west">
      <static>true</static><pose>-4.0 -2.2 0.35 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.6 0.5 0.7</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.6 0.5 0.7</size></box></geometry><material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="final_bench_east">
      <static>true</static><pose>0.0 -2.2 0.35 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.6 0.5 0.7</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.6 0.5 0.7</size></box></geometry><material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Small table in the west-central area; the main route remains open. -->
    <model name="final_table">
      <static>true</static><pose>-1.0 0.0 0.45 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.2 1.2 0.9</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.2 1.2 0.9</size></box></geometry><material><ambient>0.45 0.25 0.1 1</ambient><diffuse>0.6 0.35 0.15 1</diffuse></material></visual></link>
    </model>

    <!-- Short partition in the outer east area, away from the companion lane. -->
    <model name="final_partition">
      <static>true</static><pose>7.2 -1.0 0.8 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 2.8 1.6</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.6 2.8 1.6</size></box></geometry><material><ambient>0.2 0.45 0.55 1</ambient><diffuse>0.25 0.6 0.7 1</diffuse></material></visual></link>
    </model>

    <!-- ==================== 老人模型 ==================== -->

    <model name="elder">

      <!-- 老人整体位置 -->
      <pose>4.5 3 0 0 0 3.14159</pose>

      <static>false</static>


      <!-- 老人身体 -->

      <link name="body_link">

        <pose>0 0 0.75 0 0 0</pose>

        <gravity>false</gravity>

        <inertial>
          <mass>60.0</mass>
          <inertia>
            <ixx>12.6</ixx>
            <iyy>12.6</iyy>
            <izz>2.7</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="body_collision">

          <geometry>

            <cylinder>
              <radius>0.3</radius>
              <length>1.5</length>
            </cylinder>

          </geometry>

        </collision>


        <visual name="body_visual">

          <geometry>

            <cylinder>
              <radius>0.3</radius>
              <length>1.5</length>
            </cylinder>

          </geometry>

          <material>

            <ambient>0.2 0.3 0.8 1</ambient>

            <diffuse>0.3 0.4 0.9 1</diffuse>

          </material>

        </visual>

      </link>


      <!-- 老人头部 -->

      <link name="head_link">

        <pose>0 0 1.7 0 0 0</pose>

        <gravity>false</gravity>

        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.125</ixx>
            <iyy>0.125</iyy>
            <izz>0.125</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="head_collision">

          <geometry>

            <sphere>
              <radius>0.25</radius>
            </sphere>

          </geometry>

        </collision>


        <visual name="head_visual">

          <geometry>

            <sphere>
              <radius>0.25</radius>
            </sphere>

          </geometry>

          <material>

            <ambient>0.9 0.7 0.5 1</ambient>

            <diffuse>1 0.8 0.6 1</diffuse>

          </material>

        </visual>

      </link>

      <joint name="head_fixed_joint" type="fixed">
        <parent>body_link</parent>
        <child>head_link</child>
      </joint>

      <plugin
        filename="gz-sim-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
        <topic>/model/elder/cmd_vel</topic>
      </plugin>

    </model>
<!-- ==================== 移动机器人 ==================== -->

<include>

  <uri>model://simple_robot</uri>

  <name>elderly_robot</name>

  <!-- Start 1.46 m to the left/rear of the elder initial heading toward (3, 3). -->
  <pose>5.9 2.55 0.3 0 0 3.14159</pose>

</include>

  </world>

</sdf>
